---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Gallery from "../components/Gallery.astro";

const works = [
  { title: "Morning Silence", author: "Photo", src: "https://picsum.photos/id/1011/900/1100" },
  { title: "Still Air", author: "Illustration", src: "https://picsum.photos/id/1025/900/1100" },
  { title: "White Room", author: "Photo", src: "https://picsum.photos/id/1035/900/1100" },
  { title: "Low Tide", author: "Illustration", src: "https://picsum.photos/id/1040/900/1100" },
  { title: "Quiet Street", author: "Photo", src: "https://picsum.photos/id/1050/900/1100" },
  { title: "Soft Noon", author: "Illustration", src: "https://picsum.photos/id/1060/900/1100" },
];
---

<Layout>
  <main class="gallery-page">
    <Header title="Quiet Gallery" subtitle="Photographer & Illustrator" />
    <Gallery works={works} />
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Gallery from "../components/Gallery.astro";
import { loadWorks } from "../lib/works";

const works = await loadWorks();
---

<Layout>
  <main class="gallery-page">
    <Header
      title="Portfolio Sample"
      subtitle="Illustration"
      description="ポートフォリオサイトのインフォメーション"
    />

    <section class="intro reveal" aria-label="Statement">
      <p>
        Editorial illustration, portrait photography, still-life studies and personal works.
        Images are arranged with a restrained rhythm so the work can be seen without noise.
      </p>
    </section>

    <section class="section-heading" id="works">
      <p>Selected Works</p>
      <h2>Works</h2>
    </section>
    <Gallery works={works} />

    <section class="profile-section reveal" id="profile">
      <div>
        <p class="section-label">Profile</p>
        <h2>Illustrator / Photographer</h2>
      </div>
      <p>
        kodawariwokokonituduru
      </p>
    </section>

    <section class="contact-section" id="contact">
      <p>Contact</p>
      <a href="mailto:hello@example.com">hello@example.com</a>
      <span>Instagram / X / Commission</span>
    </section>
  </main>
</Layout>

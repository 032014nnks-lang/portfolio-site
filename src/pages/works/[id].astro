---
import Layout from "../../layouts/Layout.astro";
import { loadWorks } from "../../lib/works";
import type { Work } from "../../types/portfolio";

export async function getStaticPaths() {
  const works = await loadWorks();

  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const uploadedAt = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(work.updatedAt));
const meta = `Work / ${uploadedAt}`;
---

<Layout>
  <main class="work-detail-page">
    <nav class="detail-nav" aria-label="Work navigation">
      <a href="/works/">Works</a>
      <a href="/">Home</a>
    </nav>

    <header class="work-detail-header">
      <p>{meta}</p>
      <h1>{work.title}</h1>
    </header>

    <section class="work-images" aria-label={`${work.title} images`}>
      <img
        src={work.image.url}
        alt={work.image.alt ?? work.title}
        width={work.image.width}
        height={work.image.height}
        loading="lazy"
      />
    </section>
  </main>
</Layout>

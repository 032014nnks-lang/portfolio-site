---
import type { Work } from "../types/portfolio";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const uploadedAt = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(work.updatedAt));
const meta = `Work / ${uploadedAt}`;
---

<article class="gallery-item reveal">
  <a href={`/works/${work.id}/`} aria-label={`${work.title} の詳細を見る`}>
    <img
      src={work.image.url}
      alt={work.image.alt ?? work.title}
      width={work.image.width}
      height={work.image.height}
      loading="lazy"
    />
    <div class="work-meta">
      <h2>{work.title}</h2>
      <p>{meta}</p>
    </div>
  </a>
</article>

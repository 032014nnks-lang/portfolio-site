---
import type { Work } from "../types/portfolio";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const category = work.category ?? "Work";
const year = work.year ?? "Year";
---

<article class="gallery-item reveal">
  <a href={`/works/${work.id}/`} aria-label={`${work.title} の詳細を見る`}>
    <img
      src={work.thumbnail.url}
      alt={work.title}
      width={work.thumbnail.width}
      height={work.thumbnail.height}
      loading="lazy"
    />
    <div class="work-meta">
      <h2>{work.title}</h2>
      <p>{category} / {year}</p>
    </div>
  </a>
</article>

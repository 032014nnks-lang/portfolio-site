---
import WorkCard from "./WorkCard.astro";

interface Work {
  title: string;
  author: string;
  src: string;
}

interface Props {
  works: Work[];
}

const { works } = Astro.props;
---

<section class="gallery-grid">
  {works.map((work) => (
    <WorkCard title={work.title} author={work.author} src={work.src} />
  ))}
</section>
